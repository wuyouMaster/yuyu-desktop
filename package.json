{
  "name": "yuyu-desktop",
  "version": "0.0.0-migration.8",
  "packageManager": "pnpm@7.33.7",
  "description": "YUYU Electron application with separately installed application runtimes",
  "keywords": [
    "wechat",
    "wechat chat",
    "wechat history",
    "mac微信",
    "windows微信",
    "微信聊天记录",
    "微信聊天记录搜索",
    "微信群聊总结",
    "微信AI",
    "微信机器人",
    "AI聊天搜索",
    "AI群聊总结",
    "本地AI"
  ],
  "author": "Qingmao",
  "repository": {
    "type": "git",
    "url": "https://github.com/wuyouMaster/yuyu-desktop.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:test",
    "test": "vitest run && node --test tests/tooling/public-app-export.test.mjs tests/tooling/macos-signing.test.cjs tests/tooling/ffmpeg-license.test.cjs tests/tooling/release-artifacts.test.mjs tests/tooling/stable-release-preflight.test.mjs",
    "runtime:list": "node scripts/runtime-cli.mjs list",
    "runtime:install": "node scripts/runtime-cli.mjs install",
    "runtime:verify": "node scripts/runtime-cli.mjs verify",
    "build:runtime-worker": "node scripts/build-runtime-worker.mjs",
    "test:runtime:protocol": "vitest run --config vitest.runtime-protocol.config.ts",
    "dev": "pnpm prepare:assets && node scripts/dev.mjs",
    "build": "pnpm prepare:assets && pnpm typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:integration": "vitest run --config vitest.runtime-protocol.config.ts",
    "test:ffmpeg": "vitest run --config vitest.ffmpeg.config.ts",
    "test:e2e:build": "pnpm prepare:assets && node scripts/build-report-template-example.cjs && cross-env YUYU_E2E_BUILD=1 VITE_SCHEDULED_REPORT_DEBUG=true electron-vite build",
    "build:unpack": "pnpm build && node scripts/build-unpacked.mjs",
    "build:release:candidate": "pnpm build && node scripts/build-release.mjs",
    "release:stable:preflight": "node scripts/stable-release-preflight.mjs",
    "build:stable:candidate": "node scripts/build-stable-candidate.mjs",
    "prepare:assets": "node scripts/prepare-app-icon.mjs",
    "test:skill-install": "node scripts/test-skill-install-instruction.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@napi-rs/system-ocr": "1.2.0",
    "@napi-rs/system-ocr-win32-x64-msvc": "1.2.0",
    "@openai/agents-core": "^0.18.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.6",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "css-tree": "^3.0.1",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "5.3.0",
    "fs-extra": "^11.3.2",
    "fzstd": "^0.1.1",
    "jsonrepair": "^3.15.0",
    "openai": "^6.10.0",
    "parse5": "^8.0.0",
    "pinyin-pro": "^3.26.0",
    "qrcode": "^1.5.4",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "semver": "7.7.3",
    "sherpa-onnx-node": "1.13.3",
    "tailwind-merge": "^3.6.0",
    "unzipper": "^0.12.0",
    "wechat-emojis": "^1.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@rollup/rollup-darwin-arm64": "^4.62.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^8.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sass": "^1.102.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "win32"
      ],
      "cpu": [
        "current",
        "x64"
      ]
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "ffmpeg-static"
    ]
  },
  "private": true
}
